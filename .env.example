# PostgreSQL connection string for @repo/db (Phase 2+)
# Copy to .env at the repo root and adjust as needed, or export DATABASE_URL.
# Start a local DB with: pnpm db:up  (requires Docker)
# For Next.js API routes, also set this in apps/web/.env.local (or export it).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/assetflow
